datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SaleType {
  DIRECT_SALE  // ขายปกติ
  AUCTION      // ประมูล
}

enum Grade {
  GRADE_S // เหมือนใหม่
  GRADE_A // สภาพดีมาก
  GRADE_B // สภาพใช้งาน
  GRADE_C // มีตำหนิชัดเจน
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum EscrowStatus {
  PAYMENT_HOLDING
  AWAITING_SELLER_SHIP
  IN_INSPECTION
  INSPECTION_PASSED
  INSPECTION_FAILED
  DELIVERED_TO_BUYER
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// 1. ผู้ใช้งาน
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          Role           @default(BUYER)
  listingSlots  Int            @default(0)    // ช่องฝากขายคงเหลือ (1 ช่อง = 10 บาท)
  walletBalance Decimal        @default(0.00) @db.Decimal(10, 2)
  
  products      Product[]      @relation("SellerProducts")
  boughtOrders  Order[]        @relation("BuyerOrders")
  soldOrders    Order[]        @relation("SellerOrders")
  bids          Bid[]
  buyerOffers   Offer[]        @relation("BuyerOffers")
  sellerOffers  Offer[]        @relation("SellerOffers")
  slotPurchases SlotPurchase[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 2. สินค้ามือสอง (Unique Item 1 ชิ้น)
model Product {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String
  price           Decimal       @db.Decimal(10, 2)
  brand           String
  category        String
  size            String
  measurements    Json          // e.g. { "chest": "40", "length": "28" }
  conditionGrade  Grade
  defectDetails   String?
  
  saleType        SaleType      @default(DIRECT_SALE)
  allowOffers     Boolean       @default(true)
  
  // ข้อมูลการประมูล
  auctionStart    DateTime?
  auctionEnd      DateTime?
  minBidIncrement Decimal?      @db.Decimal(10, 2)
  
  sellerId        String
  seller          User          @relation("SellerProducts", fields: [sellerId], references: [id])
  
  isConsignment   Boolean       @default(true)
  isEscrowReady   Boolean       @default(true)
  status          ProductStatus @default(AVAILABLE)
  
  images          ProductImage[]
  orders          Order[]
  bids            Bid[]
  offers          Offer[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isMain    Boolean  @default(false)
  isDefect  Boolean  @default(false)
}

// 3. คำสั่งซื้อ + บริการพ่อค้าคนกลาง (Escrow)
model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique
  buyerId          String
  buyer            User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId         String
  seller           User          @relation("SellerOrders", fields: [sellerId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  
  productPrice     Decimal       @db.Decimal(10, 2)
  middlemanFee     Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  
  isUsingMiddleman Boolean       @default(false)
  escrowStatus     EscrowStatus?
  
  sellerTrackingNo String?
  adminTrackingNo  String?
  inspectionNote   String?
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// 4. การประมูล
model Bid {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id])
  createdAt DateTime @default(now())
}

// 5. การต่อรองราคา
model Offer {
  id            String      @id @default(uuid())
  offerAmount   Decimal     @db.Decimal(10, 2)
  status        OfferStatus @default(PENDING)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User        @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId      String
  seller        User        @relation("SellerOffers", fields: [sellerId], references: [id])
  counterAmount Decimal?    @db.Decimal(10, 2)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

// 6. การซื้อ Slot ฝากขาย (1 ช่อง = 10 บาท)
model SlotPurchase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  slotsBought Int
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}